# Telegram Bot
# 1. Create bot via @BotFather -> /newbot
# 2. Get chat_id: send message to bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
